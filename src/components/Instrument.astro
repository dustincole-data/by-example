---
/*
  One screen (tickets 07 + 08): a full-bleed field with the chrome floating over it, and a
  card at the bottom holding the question, the two labels and the strip.

  Two things in here are load-bearing and look like typos:
   - the axis glyphs are both `→`. The Y label is rendered rotate(-90deg), which maps the
     text's own +x onto screen-up, so `→` RENDERS as an up arrow and `↑` would point left.
   - the axis spans and the net canvas are aria-hidden. The field's own label names both
     axes in words, which removes two orphan labels and the "how soft right arrow"
     announcement; the net's caption does its naming in plain English.
*/
import {
  AXIS_X, AXIS_Y, LABEL_RIPE, LABEL_NOT_RIPE, NET_CAPTION, RESET, REMOVE, FIELD_ARIA,
  TITLE, BRAND_HREF, PRESET_LABEL, PRESET_PICKER_LABEL,
} from '../lib/copy';
import { PATTERN_ORDER } from '../lib/patterns';
---

<section class="instrument">
  <!-- The page had no heading at any width. It is the rail's nameplate on desktop and
       stays in the a11y tree on the phone (visually hidden), where there is no room for
       it — an addition, not a mobile design change. -->
  <h1 class="mark">{TITLE}</h1>

  <p class="explain"></p>

  <!-- Groups the field with the status chip that floats over it, so the chip's absolute
       `top` anchors to the FIELD's own edge and not to whatever now sits above it (the
       intro). `display: contents` on desktop (global.css) dissolves this box so `.fieldwrap`
       and `.chip` re-join `.instrument`'s grid as direct items, unchanged from before. -->
  <div class="fieldstage">
    <div class="fieldwrap">
      <canvas class="fieldcanvas" tabindex="0" role="application" aria-label={FIELD_ARIA}
        ><p class="fieldalt"></p></canvas
      >
      <span class="ax ax-x" aria-hidden="true">{AXIS_X}</span>
      <span class="ax ax-y" aria-hidden="true">{AXIS_Y}</span>
    </div>

    <!-- A sibling of the field, not a child of it: on the phone it floats over the field
         exactly as before, and on desktop the same element is the rail's headline. -->
    <span class="chip" role="status"></span>
  </div>

  <div class="card">
    <div class="askrow">
      <span class="ask" role="status"></span>
      <button class="rmv" type="button" hidden>{REMOVE}</button>
    </div>
    <div class="pair">
      <button class="lab rest" type="button" data-c="a" data-k="0"><i class="dot"></i>{LABEL_RIPE}</button>
      <button class="lab rest" type="button" data-c="b" data-k="1"><i class="dot"></i>{LABEL_NOT_RIPE}</button>
    </div>
    <div class="presetrow">
      <label class="presetlabel" for="preset">{PRESET_PICKER_LABEL}</label>
      <select class="preset" id="preset">
        {PATTERN_ORDER.map((key) => (
          <option value={key} selected={key === 'moons'}>{PRESET_LABEL[key]}</option>
        ))}
      </select>
    </div>
    <div class="strip">
      <span class="spacer"></span>
      <canvas class="netcanvas" aria-hidden="true"></canvas>
      <span class="spec">{NET_CAPTION}</span>
      <button class="over" type="button">{RESET}</button>
      <!-- Desktop only. Visual, and aria-hidden on purpose: it fires on every mouse move
           and says nothing the field's own description doesn't already carry. -->
      <span class="probe" aria-hidden="true"></span>
    </div>
    <p class="rmnote" role="status" hidden></p>
  </div>

  <!-- The only outbound brand link, now carrying the dc. mark instead of a bare URL.
       Desktop only: 08's one-screen phone shell has no room for it, and that gap is
       Dustin's call, not this ticket's. -->
  <a class="brand" href={BRAND_HREF} target="_blank" rel="noopener"
     aria-label="A Dustin Cole Data project">
    <svg class="dcd-mark-logo" viewBox="3.8 17.1 56.5 29.8" aria-hidden="true" focusable="false">
      <g transform="translate(2.943 46.426) scale(0.040753 -0.040753)">
        <path fill="currentColor" d="M22 269Q22 388 88.5 468.0Q155 548 262 548Q345 548 408 488V718H579V0H422V61Q354 -10 262 -10Q155 -10 88.5 70.5Q22 151 22 269ZM200 269Q200 209 230.5 176.5Q261 144 303 144Q346 144 376.0 177.0Q406 210 406 270Q406 331 376.0 362.5Q346 394 303.0 394.0Q260 394 230.0 362.0Q200 330 200 269Z"/>
        <path fill="currentColor" transform="translate(605 0)" d="M293 -10Q173 -10 97.5 68.0Q22 146 22 269Q22 389 99.5 468.5Q177 548 293 548Q404 548 479.5 479.0Q555 410 566 298H384Q382 342 357.5 368.0Q333 394 294 394Q249 394 224.0 361.0Q199 328 199 269Q199 208 223.5 175.5Q248 143 294 143Q334 143 357.5 168.5Q381 194 384 240H566Q555 125 481.5 57.5Q408 -10 293 -10Z"/>
        <path class="dcd-mark-dot" transform="translate(1163 0)" d="M241 104Q241 56 211.0 25.5Q181 -5 133.0 -5.0Q85 -5 54.5 25.5Q24 56 24 104Q24 153 54.5 183.5Q85 214 133.0 214.0Q181 214 211.0 183.5Q241 153 241 104Z"/>
      </g>
    </svg>
    <i class="dcd-mark-rule" aria-hidden="true"></i>
    <span class="dcd-mark-words"><span class="dcd-mark-name">Dustin Cole</span><span class="dcd-mark-suffix">Data</span></span>
  </a>
</section>

<script>
  import { mountInstrument } from '../scripts/instrument';
  const root = document.querySelector<HTMLElement>('.instrument');
  if (root) mountInstrument(root);
</script>
