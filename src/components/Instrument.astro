---
/*
  One screen (tickets 07 + 08): a full-bleed field with the chrome floating over it, and a
  card at the bottom holding the question, the two labels and the strip.

  Two things in here are load-bearing and look like typos:
   - the axis glyphs are both `→`. The Y label is rendered rotate(-90deg), which maps the
     text's own +x onto screen-up, so `→` RENDERS as an up arrow and `↑` would point left.
   - the axis spans and the net canvas are aria-hidden. The field's own label names both
     axes in words, which removes two orphan labels and the "how soft right arrow"
     announcement; the net's caption does its naming in plain English.
*/
import {
  AXIS_X, AXIS_Y, LABEL_RIPE, LABEL_NOT_RIPE, NET_CAPTION, RESET, REMOVE, FIELD_ARIA,
} from '../lib/copy';
---

<section class="instrument">
  <div class="fieldwrap">
    <canvas class="fieldcanvas" tabindex="0" role="application" aria-label={FIELD_ARIA}
      ><p class="fieldalt"></p></canvas
    >
    <span class="ax ax-x" aria-hidden="true">{AXIS_X}</span>
    <span class="ax ax-y" aria-hidden="true">{AXIS_Y}</span>
    <span class="chip" role="status"></span>
  </div>

  <div class="card">
    <div class="askrow">
      <span class="ask" role="status"></span>
      <button class="rmv" type="button" hidden>{REMOVE}</button>
    </div>
    <div class="pair">
      <button class="lab rest" type="button" data-c="a" data-k="0"><i class="dot"></i>{LABEL_RIPE}</button>
      <button class="lab rest" type="button" data-c="b" data-k="1"><i class="dot"></i>{LABEL_NOT_RIPE}</button>
    </div>
    <div class="strip">
      <span class="spacer"></span>
      <canvas class="netcanvas" aria-hidden="true"></canvas>
      <span class="spec">{NET_CAPTION}</span>
      <button class="over" type="button">{RESET}</button>
    </div>
    <p class="rmnote" role="status" hidden></p>
  </div>
</section>

<script>
  import { mountInstrument } from '../scripts/instrument';
  const root = document.querySelector<HTMLElement>('.instrument');
  if (root) mountInstrument(root);
</script>
